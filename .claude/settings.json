{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.ssh/**)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/secrets/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)",
      "Bash(npm run deploy *)",
      "Bash(pnpm run deploy *)",
      "Bash(yarn deploy *)",
      "Bash(terraform apply *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(docker system prune *)",
      "Bash(rm *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/log_team_message.py"]
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/log_team_message.py"]
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/log_team_message.py"]
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/log_team_message.py"]
          }
        ]
      }
    ]
  }
}
