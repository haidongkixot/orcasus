+
+// Start of the export window: the same calendar instant 12 months before `now` (UTC).
+export function exportCutoff(now) {
+  const cutoff = new Date(now.getTime());
+  cutoff.setUTCMonth(cutoff.getUTCMonth() - 12);
+  return cutoff;
+}
+
+// Invoices of one organization issued within the last 12 months (PRD R3, TICKET-12).
+// Invoices without a valid `issuedAt` are excluded: their age cannot be proven.
+export function exportableInvoices(invoices, { orgId, now = new Date() }) {
+  const cutoff = exportCutoff(now).getTime();
+  return listInvoices(invoices, { orgId }).filter((invoice) => {
+    const issued = Date.parse(invoice.issuedAt);
+    return Number.isFinite(issued) && issued >= cutoff;
+  });
+}
+
+export const CSV_COLUMNS = ["id", "issuedAt", "status", "totalCents"];
+
+// One CSV cell. Text starting with a formula trigger is prefixed with `'` so
+// spreadsheets treat it as text (CSV/formula injection), then RFC 4180 quoting applies.
+export function csvCell(value) {
+  if (value === null || value === undefined) return "";
+  let text = String(value);
+  if (typeof value === "string" && /^[=+\-@\t\r]/.test(text)) text = `'${text}`;
+  if (/[",\r\n]/.test(text)) text = `"${text.replace(/"/g, '""')}"`;
+  return text;
+}
+
+export function invoicesToCsv(invoices) {
+  const rows = invoices.map((invoice) => [invoice.id, invoice.issuedAt, invoice.status, invoiceTotal(invoice)]);
+  return [CSV_COLUMNS, ...rows].map((row) => row.map(csvCell).join(",")).join("\r\n") + "\r\n";
+}
