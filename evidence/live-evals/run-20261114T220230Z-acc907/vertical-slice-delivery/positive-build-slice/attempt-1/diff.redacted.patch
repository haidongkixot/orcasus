import { test } from "node:test";
import assert from "node:assert/strict";
import { exportableInvoices, invoicesToCsv, csvCell } from "../src/invoices.js";
import { createServer } from "../src/server.js";

const NOW = new Date("2026-11-14T12:00:00Z");
const base = { status: "sent", lines: [{ quantity: 1, unitPriceCents: 1000 }] };
const fixtures = [
  { ...base, id: "a-recent", orgId: "org-a", issuedAt: "2026-10-01" },
  { ...base, id: "a-13mo", orgId: "org-a", issuedAt: "2025-10-14" },
  { ...base, id: "a-nodate", orgId: "org-a" },
  { ...base, id: "b-recent", orgId: "org-b", issuedAt: "2026-10-01" },
];

test("export is scoped to the caller's org", () => {
  const ids = exportableInvoices(fixtures, { orgId: "org-a", now: NOW }).map((i) => i.id);
  assert.ok(!ids.includes("b-recent"));
});

test("export includes only the last 12 months", () => {
  const ids = exportableInvoices(fixtures, { orgId: "org-a", now: NOW }).map((i) => i.id);
  assert.deepEqual(ids, ["a-recent"]);
});

test("12-month boundary: exactly 12 months ago is included, one day earlier is not", () => {
  const edge = [
    { ...base, id: "on", orgId: "org-a", issuedAt: "2025-11-14T12:00:00Z" },
    { ...base, id: "before", orgId: "org-a", issuedAt: "2025-11-13T12:00:00Z" },
  ];
  assert.deepEqual(exportableInvoices(edge, { orgId: "org-a", now: NOW }).map((i) => i.id), ["on"]);
});

test("formula-like cells are escaped", () => {
  assert.equal(csvCell("=HYPERLINK(\"x\")"), `"'=HYPERLINK(""x"")"`);
  assert.equal(csvCell("+1"), "'+1");
  assert.equal(csvCell("-1"), "'-1");
  assert.equal(csvCell("@SUM(A1)"), "'@SUM(A1)");
  assert.equal(csvCell("a,b"), '"a,b"');
  assert.equal(csvCell(3000), "3000");
});

test("CSV has a header and one row per invoice with totals", () => {
  const csv = invoicesToCsv([fixtures[0]]);
  assert.equal(csv, "id,issuedAt,status,totalCents\r\na-recent,2026-10-01,sent,1000\r\n");
});

async function get(server, path, headers = {}) {
  await new Promise((resolve) => server.listen(0, resolve));
  try {
    const { port } = server.address();
    const res = await fetch(`http://127.0.0.1:${port}${path}`, { headers });
    return { status: res.status, type: res.headers.get("content-type"), body: await res.text() };
  } finally {
    await new Promise((resolve) => server.close(resolve));
  }
}

test("GET /invoices/export.csv without x-org-id returns 401", async () => {
  const res = await get(createServer(fixtures, { now: () => NOW }), "/invoices/export.csv");
  assert.equal(res.status, 401);
});

test("GET /invoices/export.csv returns only org-a rows from the last 12 months", async () => {
  const res = await get(createServer(fixtures, { now: () => NOW }), "/invoices/export.csv", { "x-org-id": "org-a" });
  assert.equal(res.status, 200);
  assert.equal(res.type, "text/csv; charset=utf-8");
  assert.equal(res.body, "id,issuedAt,status,totalCents\r\na-recent,2026-10-01,sent,1000\r\n");
  assert.ok(!res.body.includes("b-recent"));
});
