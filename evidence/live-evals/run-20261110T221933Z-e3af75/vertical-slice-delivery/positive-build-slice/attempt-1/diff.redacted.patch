@@ -15,3 +15,22 @@ export function changeStatus(invoice, next, actor) {
 export function listInvoices(invoices, { orgId }) {
   return invoices.filter((invoice) => invoice.orgId === orgId);
 }
+
+// Cells a spreadsheet may evaluate as a formula (OWASP CSV injection guidance).
+const FORMULA_PREFIX = /^[=+\-@\t\r]/;
+
+function csvCell(value) {
+  if (value === null || value === undefined) return "";
+  if (typeof value === "number") return String(value);
+  let text = String(value);
+  if (FORMULA_PREFIX.test(text)) text = `'${text}`;
+  if (/[",\r\n]/.test(text) || text !== text.trim()) text = `"${text.replace(/"/g, '""')}"`;
+  return text;
+}
+
+// RFC 4180 CSV: header row, CRLF line endings. `columns` is [{ header, value: (row) => cell }].
+export function toCsv(columns, rows) {
+  const lines = [columns.map((c) => csvCell(c.header)).join(",")];
+  for (const row of rows) lines.push(columns.map((c) => csvCell(c.value(row))).join(","));
+  return lines.join("\r\n") + "\r\n";
+}

--- new file: test/csv.test.js ---
import { test } from "node:test";
import assert from "node:assert/strict";
import { toCsv } from "../src/invoices.js";

const cols = [
  { header: "id", value: (r) => r.id },
  { header: "amount", value: (r) => r.amount },
];

test("writes a header row and CRLF-terminated rows", () => {
  assert.equal(toCsv(cols, [{ id: "inv-1", amount: 3000 }]), "id,amount\r\ninv-1,3000\r\n");
});

test("cells starting with a formula character are escaped", () => {
  for (const bad of ["=HYPERLINK(\"x\")", "+1", "-1+1", "@SUM(A1)", "\tcmd"]) {
    const cell = toCsv(cols, [{ id: bad, amount: 0 }]).split("\r\n")[1];
    assert.ok(/^"?'/.test(cell), `not escaped: ${JSON.stringify(cell)}`);
  }
});

test("numeric cells, including negatives, are not prefixed", () => {
  assert.equal(toCsv(cols, [{ id: "a", amount: -500 }]).split("\r\n")[1], "a,-500");
});

test("commas, quotes and newlines are quoted per RFC 4180", () => {
  assert.equal(toCsv(cols, [{ id: 'a,"b"\nc', amount: 1 }]).split("\r\n").slice(1).join("\r\n"), '"a,""b""\nc",1\r\n');
});

test("null and undefined become empty cells", () => {
  assert.equal(toCsv(cols, [{ id: null, amount: undefined }]).split("\r\n")[1], ",");
});
