ice, \"sent\", { role: \"member\" });","+  });","+  assert.equal(sent.status, \"sent\");","+});","+"," test(\"list is scoped to the caller's org\", () => {","   const rows = listInvoices([invoice, { ...invoice, id: \"inv-2\", orgId: \"org-b\" }], { orgId: \"org-a\" });","   assert.deepEqual(rows.map((r) => r.id), [\"inv-1\"]);"]}],"userModified":false,"replaceAll":false,"gitDiff":{"filename":"test/invoices.test.js","status":"modified","additions":8,"deletions":0,"changes":8,"patch":"@@ -13,6 +13,14 @@ test(\"only admins can void\", () => {\n   assert.equal(changeStatus(invoice, \"void\", { role: \"admin\" }).status, \"void\");\n });\n \n+test(\"members can send a draft invoice\", () => {\n+  let sent;\n+  assert.doesNotThrow(() => {\n+    sent = changeStatus(invoice, \"sent\", { role: \"member\" });\n+  });\n+  assert.equal(sent.status, \"sent\");\n+});\n+\n test(\"list is scoped to the caller's org\", () => {\n   const rows = listInvoices([invoice, { ...invoice, id: \"inv-2\", orgId: \"org-b\" }], { orgId: \"org-a\" });\n   assert.deepEqual(rows.map((r) => r.id), [\"inv-1\"]);","repository":null}},"tool_result_meta":[{"id":"toolu_01An5vPiaYgM1V9HAU8QQS3h","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
